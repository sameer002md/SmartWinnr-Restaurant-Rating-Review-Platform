# Backend environment configuration
# Copy this file to .env and replace every placeholder with your own values.

PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Atlas example:
MONGO_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER_HOST>/<DATABASE_NAME>?retryWrites=true&w=majority

# Generate a long random value; never reuse or publish a real secret.
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# Used only if your create-admin bootstrap script reads these variables.
ADMIN_NAME=SmartWinnr Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThis_Admin123!
